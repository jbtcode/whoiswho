# Copy to .env and fill in for a real deployment. Do not commit the real .env.
#
# "mock" enables the local-only fake login form (see auth.py MockProvider).
# Any other value (including leaving this unset) requires real Entra ID SSO
# and disables the mock login entirely. run_app.py sets this to "mock" by
# default for local development only.
WHOISWHO_AUTH_MODE=

# Required whenever WHOISWHO_AUTH_MODE is not "mock". Used to sign session
# cookies - must be a long random value, kept secret.
WHOISWHO_SECRET_KEY=

# Entra ID / Azure AD app registration details. Required whenever
# WHOISWHO_AUTH_MODE is not "mock".
WHOISWHO_ENTRA_TENANT_ID=
WHOISWHO_ENTRA_CLIENT_ID=
WHOISWHO_ENTRA_CLIENT_SECRET=
WHOISWHO_ENTRA_REDIRECT_URI=

# Comma-separated Entra ID group object IDs allowed to access the app.
# Leave empty to allow any authenticated user in the tenant.
WHOISWHO_ENTRA_ALLOWED_GROUPS=
